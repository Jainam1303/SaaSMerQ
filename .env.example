# Copy to .env.local and fill in as needed. All are optional —
# the platform runs fully without any of these set.

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Inlined at build time; GA only loads in production builds.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Deprecated alias for the GA4 measurement ID (still read as a fallback).
NEXT_PUBLIC_GA_ID=

# Plausible analytics domain (e.g. merqprime.in)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Google Search Console verification token (the content value only)
NEXT_PUBLIC_GSC_VERIFICATION=

# HTTP Basic Auth password for /admin/* (username: admin). When unset, admin routes return 404.
ADMIN_PASSWORD=change-me
